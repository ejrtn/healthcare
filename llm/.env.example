# eval/ragas_eval.py가 로컬 judge 외에 Gemini/Claude/ChatGPT도 judge로 써보게
# 하려면, 이 파일을 복사해서 ".env"라는 이름으로 저장하고 실제 키를 채워 넣는다
# (.env는 .gitignore에 있어서 절대 git에 커밋되지 않는다).
#
#   cp .env.example .env    # 이 파일을 복사
#   # 아래 값들을 실제 키로 채운 뒤 저장
#
# 셋 다 선택사항이다 — 하나도 안 채워도 로컬 judge만으로 정상 동작한다.
# 변수 이름은 회사명(Google/Anthropic/OpenAI)이 아니라 서비스 이름
# (Gemini/Claude/ChatGPT)으로 통일해서 헷갈리지 않게 했다.
# 키 발급처:
#   GEMINI_API_KEY   -> https://aistudio.google.com/apikey (무료 티어 있음)
#   CLAUDE_API_KEY   -> https://console.anthropic.com (유료)
#   CHATGPT_API_KEY  -> https://platform.openai.com/api-keys (유료)

GEMINI_API_KEY=
CLAUDE_API_KEY=
CHATGPT_API_KEY=
